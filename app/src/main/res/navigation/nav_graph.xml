<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/roleSelectFragment">

    <!-- AUTH SCREENS -->
    <fragment
        android:id="@+id/roleSelectFragment"
        android:name="com.example.peertutoringsystem.ui.auth.RoleSelectFragment"
        android:label="Role Select"
        tools:layout="@android:layout/simple_list_item_1">
        <action
            android:id="@+id/action_roleSelect_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_roleSelect_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.peertutoringsystem.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@android:layout/simple_list_item_1">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.peertutoringsystem.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@android:layout/simple_list_item_1">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- HOME & PROFILE -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.peertutoringsystem.ui.main.HomeFragment"
        android:label="Home"
        tools:layout="@android:layout/simple_list_item_1" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.peertutoringsystem.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@android:layout/simple_list_item_1" />

    <!-- REQUESTS -->
    <fragment
        android:id="@+id/requestListFragment"
        android:name="com.example.peertutoringsystem.ui.requests.RequestListFragment"
        android:label="Request List"
        tools:layout="@android:layout/simple_list_item_1">
        <action
            android:id="@+id/action_requestList_to_requestForm"
            app:destination="@id/requestFormFragment" />
        <action
            android:id="@+id/action_requestList_to_requestDetail"
            app:destination="@id/requestDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/requestFormFragment"
        android:name="com.example.peertutoringsystem.ui.requests.RequestFormFragment"
        android:label="Create/Edit Request"
        tools:layout="@android:layout/simple_list_item_1" />

    <fragment
        android:id="@+id/requestDetailFragment"
        android:name="com.example.peertutoringsystem.ui.requests.RequestDetailFragment"
        android:label="Request Detail"
        tools:layout="@android:layout/simple_list_item_1">
        <action
            android:id="@+id/action_requestDetail_to_respond"
            app:destination="@id/respondFragment" />
        <action
            android:id="@+id/action_requestDetail_to_offers"
            app:destination="@id/offersForRequestFragment" />
    </fragment>

    <!-- OFFERS -->
    <fragment
        android:id="@+id/respondFragment"
        android:name="com.example.peertutoringsystem.ui.offers.RespondFragment"
        android:label="Respond to Request"
        tools:layout="@android:layout/simple_list_item_1" />

    <fragment
        android:id="@+id/offersForRequestFragment"
        android:name="com.example.peertutoringsystem.ui.offers.OffersForRequestFragment"
        android:label="Offers for Request"
        tools:layout="@android:layout/simple_list_item_1">
        <action
            android:id="@+id/action_offers_to_schedule"
            app:destination="@id/scheduleSessionFragment" />
    </fragment>

    <fragment
        android:id="@+id/myOffersFragment"
        android:name="com.example.peertutoringsystem.ui.offers.MyOffersFragment"
        android:label="My Offers"
        tools:layout="@android:layout/simple_list_item_1" />

    <!-- SESSIONS -->
    <fragment
        android:id="@+id/scheduleSessionFragment"
        android:name="com.example.peertutoringsystem.ui.sessions.ScheduleSessionFragment"
        android:label="Schedule Session"
        tools:layout="@android:layout/simple_list_item_1" />

    <fragment
        android:id="@+id/sessionsListFragment"
        android:name="com.example.peertutoringsystem.ui.sessions.SessionsListFragment"
        android:label="Sessions List"
        tools:layout="@android:layout/simple_list_item_1" />

</navigation>